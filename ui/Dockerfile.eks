# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:24.22.1-alpine3.24 AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY . .

# Build-time arguments — injected from GitHub vars in the workflow.
# Every VITE_* value is compiled into the public JS bundle, so none of them may
# be a secret. The API credentials are given to nginx at runtime instead
# (see scripts/configure-nginx.sh).
ARG VITE_ISSUER_NAME
ARG VITE_ISSUER_LOGO
ARG VITE_BUILD_TAG
ARG VITE_WARNING_MESSAGE
ARG VITE_IPFS_GATEWAY_URL
ARG VITE_SCHEMA_EXPLORER_AND_BUILDER_URL
ARG VITE_DISPLAY_METHOD_BUILDER_URL
ARG VITE_BASE_URL
ARG VITE_PAYMENT_PAGES_ENABLED

RUN test -n "$VITE_ISSUER_NAME"      || { echo "ERROR: VITE_ISSUER_NAME is required"; exit 1; } \
 && test -n "$VITE_IPFS_GATEWAY_URL" || { echo "ERROR: VITE_IPFS_GATEWAY_URL is required"; exit 1; }

RUN echo "VITE_ISSUER_NAME=$VITE_ISSUER_NAME" >> .env \
 && echo "VITE_ISSUER_LOGO=$VITE_ISSUER_LOGO" >> .env \
 && echo "VITE_BUILD_TAG=$VITE_BUILD_TAG" >> .env \
 && echo "VITE_WARNING_MESSAGE=$VITE_WARNING_MESSAGE" >> .env \
 && echo "VITE_IPFS_GATEWAY_URL=$VITE_IPFS_GATEWAY_URL" >> .env \
 && echo "VITE_SCHEMA_EXPLORER_AND_BUILDER_URL=$VITE_SCHEMA_EXPLORER_AND_BUILDER_URL" >> .env \
 && echo "VITE_DISPLAY_METHOD_BUILDER_URL=$VITE_DISPLAY_METHOD_BUILDER_URL" >> .env \
 && echo "VITE_BASE_URL=$VITE_BASE_URL" >> .env \
 && echo "VITE_PAYMENT_PAGES_ENABLED=$VITE_PAYMENT_PAGES_ENABLED" >> .env

RUN npm run build

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM nginx:alpine

RUN apk add --no-cache apache2-utils

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployment/ /app/deployment/
COPY scripts/deploy-eks.sh scripts/configure-nginx.sh /app/scripts/

RUN chmod +x /app/scripts/deploy-eks.sh /app/scripts/configure-nginx.sh

ENTRYPOINT ["/bin/sh", "/app/scripts/deploy-eks.sh"]
